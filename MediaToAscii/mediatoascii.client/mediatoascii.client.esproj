<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.6165494">
  <PropertyGroup>
    <StartupCommand>npm start</StartupCommand>
    <!-- Allows the build (or compile) script located on package.json to run on Build -->
    <ShouldRunBuildScript>false</ShouldRunBuildScript>
    <!-- Folder where production build objects will be placed -->
    <BuildOutputFolder>$(MSBuildProjectDirectory)\dist\mediatoascii.client\browser\</BuildOutputFolder>
    <!-- Keep build/deps folders out of Solution Explorer / default globs -->
    <DefaultItemExcludes>$(DefaultItemExcludes);dist\**;dist/**;.angular\**;.angular/**;node_modules\**;node_modules/**;.vscode\**;.vscode/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="dist\**;dist/**;.angular\**;.angular/**;node_modules\**;node_modules/**;.vscode\**;.vscode/**" />
    <None Remove="dist\**;dist/**;.angular\**;.angular/**;node_modules\**;node_modules/**;.vscode\**;.vscode/**" />
  </ItemGroup>
</Project>
